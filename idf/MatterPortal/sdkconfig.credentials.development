# Default development credentials; Home Assistant requires Test DCL.
CONFIG_ARDPORTAL_MATTER_DEVELOPMENT=y
CONFIG_ARDPORTAL_MATTER_PRODUCTION=n
CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER=n
CONFIG_ENABLE_ESP32_DEVICE_INSTANCE_INFO_PROVIDER=n
CONFIG_EXAMPLE_DAC_PROVIDER=y
CONFIG_EXAMPLE_COMMISSIONABLE_DATA_PROVIDER=y
CONFIG_EXAMPLE_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_ENABLE_TEST_SETUP_PARAMS=y
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="nvs"
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
