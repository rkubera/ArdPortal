CONFIG_ARDPORTAL_MATTER_THREAD_WIFI=y
CONFIG_ARDUINO_SELECTIVE_WiFi=y
CONFIG_ARDUINO_SELECTIVE_AsyncUDP=y
CONFIG_ARDUINO_SELECTIVE_DNSServer=y
# Wi-Fi belongs to ArdPortal; expose only Thread to Matter commissioning.
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_MATTER_OVER_THREAD=y
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_THREAD_NETWORK_ENDPOINT_ID=0
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Leave DMA heap for concurrent Wi-Fi, Thread and BLE commissioning.
CONFIG_OPENTHREAD_NUM_MESSAGE_BUFFERS=32

# Allocate Matter pool entries on demand rather than reserving unused entries.
CONFIG_CHIP_SYSTEM_CONFIG_POOL_USE_HEAP=y
